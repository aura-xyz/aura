{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aura",
  "version": "0.6.0",
  "identifier": "com.jacksai.aura",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/aura-xyz/aura/releases/latest/download/latest.json",
        "https://cdn.jsdelivr.net/gh/aura-xyz/aura@main/release/latest.json",
        "https://raw.githubusercontent.com/aura-xyz/aura/main/release/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNEI5NzZFMjg5QUMyQjYKUldTMndwb29icGRMNjlVaVVNZnRhM0ZOOFUzRDlUa1FhVHhsT2lJNFF3dXd2SDNsekMyczEreDkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/builtin-skills": "builtin-skills/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

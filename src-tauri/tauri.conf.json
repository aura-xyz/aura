{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aura",
  "version": "0.8.0-rc.2",
  "identifier": "com.jacksai.aura",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src https: http:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data: blob: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420; frame-src https: http:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://v4.gh-proxy.org/https://raw.githubusercontent.com/aura-xyz/aura/main/release/latest.json",
        "https://gh-proxy.com/https://raw.githubusercontent.com/aura-xyz/aura/main/release/latest.json",
        "https://raw.githubusercontent.com/aura-xyz/aura/main/release/latest.json",
        "https://github.com/aura-xyz/aura/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCNEI5NzZFMjg5QUMyQjYKUldTMndwb29icGRMNjlVaVVNZnRhM0ZOOFUzRDlUa1FhVHhsT2lJNFF3dXd2SDNsekMyczEreDkK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/builtin-skills": "builtin-skills/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "assets/installer/header.bmp",
        "uninstallerHeaderImage": "assets/installer/header.bmp",
        "sidebarImage": "assets/installer/sidebar.bmp"
      }
    }
  }
}
